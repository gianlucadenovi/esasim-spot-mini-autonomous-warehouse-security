{
    "id": "ws-spot-mujoco-and-warehouse-patrol",
    "version": "1",
    "name": "Spot · MuJoCo and warehouse patrol",
    "category": "Simulation",
    "icon": "code",
    "side": "backend",
    "customizable": true,
    "summary": "Spot Menagerie physics experiments and 30-minute synthetic warehouse surveillance",
    "help": "Modes stand/walk/terrain perform actual MuJoCo physics and simple randomized gait-controller tuning; patrol produces simulated navigation/sensor alarms. All results labeled honestly.",
    "inputs": [],
    "outputs": [
        {
            "id": "policy",
            "label": "Controller / waypoints",
            "type": "files",
            "formats": [
                "json"
            ]
        },
        {
            "id": "table",
            "label": "Trials or patrol telemetry",
            "type": "table",
            "formats": [
                "csv"
            ]
        },
        {
            "id": "report",
            "label": "Audit and incident report",
            "type": "files",
            "formats": [
                "md",
                "json"
            ]
        },
        {
            "id": "poses",
            "label": "3D path and physical pose",
            "type": "table",
            "formats": [
                "csv"
            ],
            "help": "Physical MuJoCo base trajectory on training flows; synthetic route on patrol"
        },
        {
            "id": "models",
            "label": "Spot actual 3D mesh",
            "type": "files",
            "formats": [
                "glb"
            ]
        }
    ],
    "params": [
        {
            "key": "mode",
            "label": "Flow",
            "type": "select",
            "default": "stand",
            "options": [
                "stand",
                "walk",
                "terrain",
                "patrol"
            ]
        },
        {
            "key": "minutes",
            "label": "Simulated patrol minutes",
            "type": "number",
            "default": 30,
            "min": 1,
            "max": 180
        },
        {
            "key": "trials",
            "label": "Physics optimization trials",
            "type": "number",
            "default": 8,
            "min": 2,
            "max": 24
        },
        {
            "key": "seed",
            "label": "Scenario seed",
            "type": "number",
            "default": 17
        }
    ],
    "hardware": [
        "cpu",
        "nvidia"
    ],
    "packages": [
        "mujoco>=3.3,<4",
        "trimesh>=4.0",
        "numpy"
    ],
    "esasim": {
        "version": 5
    }
}
